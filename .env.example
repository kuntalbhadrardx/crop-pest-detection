# ---------------------------------------------------------------------------
# Crop Pest & Disease Detection API - environment configuration
# Copy to .env and adjust. Every value below is also the code default,
# so an empty/absent .env works out of the box.
# ---------------------------------------------------------------------------

# ---- Model ----------------------------------------------------------------
# Path to your trained weights (created by scripts/train.py).
# Relative paths resolve against the project root.
MODEL_PATH=models/custom.pt

# Downloaded automatically on first run when MODEL_PATH does not exist yet,
# so the API works end-to-end before you train. Detection classes will be
# generic COCO classes until you train your own model.
FALLBACK_MODEL=yolov8n.pt

CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
IMAGE_SIZE=640

# "" = auto (CUDA if available, else CPU). Force with "cpu" or "cuda:0".
DEVICE=

# ---- Storage ---------------------------------------------------------------
DATABASE_URL=sqlite:///./data/scans.db
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# ---- Behaviour -------------------------------------------------------------
# Class names that never count as "affected". Most pest datasets also label
# healthy leaves; if yours includes a class named "healthy", keep this.
# Remove the line entirely if your model has no healthy class.
HEALTHY_CLASSES=["healthy"]

# Comma/JSON list for a browser frontend, e.g. ["http://localhost:5173"]
CORS_ORIGINS=["*"]

# ---- Weather / risk forecasting --------------------------------------------
# Provider is swappable (see app/services/weather.py). The default fetches a
# free Open-Meteo forecast and caches it to disk, so risk forecasting keeps
# working offline for 24 h after the last successful fetch.
WEATHER_PROVIDER=open-meteo
WEATHER_CACHE_TTL_HOURS=24
WEATHER_CACHE_PATH=data/weather_cache.json

# ---- Dataset downloads (training only) -------------------------------------
ROBOFLOW_API_KEY=
